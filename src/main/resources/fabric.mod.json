{
  "schemaVersion": 1,
  "id": "bbs_lip_sync",
  "version": "${version}",
  "name": "BBS Lip Sync",
  "description": "Generates mouth pose keyframes from speech in BBS films, using offline Vosk speech recognition in over 20 languages.",
  "authors": ["Wemppy"],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.wemppy.bbs_lip_sync.Bbs_lip_sync"
    ],
    "client": [
      "com.wemppy.bbs_lip_sync.client.Bbs_lip_syncClient"
    ],
    "bbs-addon": [
      "com.wemppy.bbs_lip_sync.LipSyncAddon"
    ],
    "bbs-client-addon": [
      "com.wemppy.bbs_lip_sync.client.LipSyncClientAddon"
    ]
  },
  "mixins": [
    "bbs_lip_sync.mixins.json",
    {
      "config": "bbs_lip_sync.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "bbs": "*"
  }
}
