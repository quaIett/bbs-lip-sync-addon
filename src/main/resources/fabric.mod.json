{
  "schemaVersion": 1,
  "id": "bbs_lip_sync",
  "version": "${version}",
  "name": "BBS Lip Sync",
  "description": "Lip sync for BBS films: mouth pose or texture keyframes from speech (offline Vosk recognition in over 20 languages) or from typed text.",
  "authors": ["Wemppy"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/bbs_lip_sync/icon.png",
  "environment": "client",
  "entrypoints": {
    "bbs-addon": [
      "com.wemppy.bbs_lip_sync.LipSyncAddon"
    ],
    "bbs-client-addon": [
      "com.wemppy.bbs_lip_sync.client.LipSyncClientAddon"
    ]
  },
  "mixins": [
    "bbs_lip_sync.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "bbs": ">=2.8-0"
  }
}
